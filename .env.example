# 通用多模型 Provider 配置（默认 deepseek，支持任意 OpenAI-compatible 接口）
# 可选值：deepseek | gemini | openrouter | groq | together | nvidia | zai | sambanova | amd | novita | merkium | hetzner | unorouter | llmkiwi | maritaca | cheapllm | exaone | requesty | zro | openai | openai-compatible
AI_PROVIDER=deepseek
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# DeepSeek 默认兼容配置（当 AI_PROVIDER=deepseek 或未设置时自动读取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PRIMARY_MODEL=deepseek-v4-flash
AI_FALLBACK_MODEL=deepseek-v4-pro

# 其他 OpenAI-compatible Provider 配置示例（按需取消注释并填入你自己的环境变量，切勿提交真实密钥）：
# --- Google Gemini (OpenAI-compatible) ---
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=
# AI_MODEL=gemini-4-hydrogen

