# 通用多模型 Provider 配置（默认 deepseek，支持任意 OpenAI-compatible 接口）
# 可选值：deepseek | gemini | openrouter | groq | together | openai | openai-compatible
AI_PROVIDER=deepseek
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# DeepSeek 默认兼容配置（当 AI_PROVIDER=deepseek 或未设置时自动读取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PRIMARY_MODEL=deepseek-v4-flash
AI_FALLBACK_MODEL=deepseek-v4-pro

# 其他 OpenAI-compatible Provider 配置示例（按需取消注释并填入你自己的环境变量，切勿提交真实密钥）：
# --- Google Gemini (OpenAI-compatible) ---
# AI_PROVIDER=gemini
# AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
# GEMINI_API_KEY=
# AI_MODEL=gemini-3.5-flash

# --- OpenRouter ---
# AI_PROVIDER=openrouter
# AI_BASE_URL=https://openrouter.ai/api/v1
# OPENROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-chat

# --- Groq ---
# AI_PROVIDER=groq
# AI_BASE_URL=https://api.groq.com/openai/v1
# GROQ_API_KEY=
# AI_MODEL=llama-3.3-70b-versatile

# --- Together AI ---
# AI_PROVIDER=together
# AI_BASE_URL=https://api.together.xyz/v1
# TOGETHER_API_KEY=
# AI_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo

# 可选保护开关（设为 true 时关闭模型问答）
CHAT_DISABLED=false

# Upstash Redis：Vercel Marketplace 默认注入 KV_REST_API_*；未配置时仅在单实例内存中限流
KV_REST_API_URL=
KV_REST_API_TOKEN=
PRIVACY_HASH_SALT=
RATE_LIMIT_PER_MINUTE=5
SESSION_QUESTION_LIMIT=20
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=300000
TOKEN_RESERVATION=1500

# Neon Postgres：未配置时匿名埋点静默关闭
DATABASE_URL=
CRON_SECRET=

# Vercel Blob：RESUME_ 前缀连接自动注入 Token，运行时只读取公开 PDF 地址
RESUME_READ_WRITE_TOKEN=
RESUME_STORE_ID=
RESUME_BLOB_URL=

# 仅本地使用：Obsidian 原文不进入部署环境，同步结果默认写入已忽略的 output/
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SYNC_OUTPUT=output/obsidian-review.json
