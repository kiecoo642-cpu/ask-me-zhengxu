# --- FreeAPIAI（免密钥、免注册、无付费档；SDK 需非空 key 时默认使用占位符 "free"）---
# 注：官方声明无审核层、无 SLA/在线率保证，且记录请求技术日志（时间、IP、UA、国家、端点、状态、用量）
# AI_PROVIDER=freeapiai
# AI_BASE_URL=https://api.freeapiai.com/v1
# FREEAPIAI_API_KEY=
# AI_MODEL=free-ai

# --- SiliconFlow（免费模型 0 费用；需中国大陆/港澳台实名认证+支付宝人脸识别，仅限该区域使用）---
# AI_PROVIDER=siliconflow
# AI_BASE_URL=https://api.siliconflow.cn/v1
# SILICONFLOW_API_KEY=
# AI_MODEL=Qwen/Qwen3-8B

# --- ModelScope 魔搭 API-Inference（ms-... 令牌；须绑定实名认证阿里云账号 + 验证邮箱；仅限非商业体验、无 SLA 保障）---
# AI_PROVIDER=modelscope
# AI_BASE_URL=https://api-inference.modelscope.cn/v1
# MODELSCOPE_API_KEY=
# AI_MODEL=Qwen/Qwen3.5-35B-A3B

# --- OrcaRouter（sk-orca-...；免费包 10 RPM / 50 RPD，清单轮换；可能须绑定有历史 GitHub 或任意付费，待实测）---
# AI_PROVIDER=orcarouter
# AI_BASE_URL=https://api.orcarouter.ai/v1
# ORCAROUTER_API_KEY=
# AI_MODEL=deepseek/deepseek-v4.1-flash-free

# --- 智谱 BigModel（国内版开放平台；glm-4.7-flash 免费，备选 glm-4.6v-flash；与国际版 Z.ai 不同平台）---
# AI_PROVIDER=bigmodel
# AI_BASE_URL=https://open.bigmodel.cn/api/paas/v4
# BIGMODEL_API_KEY=
# AI_MODEL=glm-4.7-flash

# --- 商汤 SenseNova Token Plan（免费档 ¥0/月公测限额；需手机号验证）---
# AI_PROVIDER=sensenova
# AI_BASE_URL=https://token.sensenova.cn/v1
# SENSENOVA_API_KEY=
# AI_MODEL=sensenova-6.8-flash-lite

# 可选保护开关（设为 true 时关闭模型问答）
CHAT_DISABLED=false

# Upstash Redis：Vercel Marketplace 默认注入 KV_REST_API_*；未配置时仅在单实例内存中限流
KV_REST_API_URL=
KV_REST_API_TOKEN=
PRIVACY_HASH_SALT=
RATE_LIMIT_PER_MINUTE=5
SESSION_QUESTION_LIMIT=20
DAILY_REQUEST_LIMIT=200
DAILY_TOKEN_LIMIT=300000
TOKEN_RESERVATION=1500

# Neon Postgres：未配置时匿名埋点静默关闭
DATABASE_URL=
CRON_SECRET=

# Vercel Blob：RESUME_ 前缀连接自动注入 Token，运行时只读取公开 PDF 地址
RESUME_READ_WRITE_TOKEN=
RESUME_STORE_ID=
RESUME_BLOB_URL=

# 仅本地使用：Obsidian 原文不进入部署环境，同步结果默认写入已忽略的 output/
OBSIDIAN_VAULT_PATH=
OBSIDIAN_SYNC_OUTPUT=output/obsidian-review.json
