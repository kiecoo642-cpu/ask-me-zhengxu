# 通用多模型 Provider 配置（默认 deepseek，支持任意 OpenAI-compatible 接口）
# 可选值：deepseek | gemini | openrouter | groq | together | nvidia | zai | sambanova | amd | novita | merkium | hetzner | unorouter | llmkiwi | cheapllm | exaone | requesty | zro | aihubmix | freeai | freeapiai | siliconflow | modelscope | orcarouter | bigmodel | sensenova | openai | openai-compatible
AI_PROVIDER=deepseek
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# DeepSeek 默认兼容配置（当 AI_PROVIDER=deepseek 或未设置时自动读取）
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
AI_PRIMARY_MODEL=deepseek-v4-flash
AI_FALLBACK_MODEL=deepseek-v4-pro

